
import json
from google.oauth2.service_account import Credentials
import gspread

# Tu string de credenciales (o importado desde config.py)
GOOGLE_CREDENTIALS = """
{
  "type": "service_account",
  "project_id": "censo-vacunacion-issste",
  ...
}
"""

def obtener_cliente_gspread():
    # 1. Convertir el texto JSON a un diccionario de Python
    creds_dict = json.loads(GOOGLE_CREDENTIALS)
    
    # 2. Definir los ámbitos (scopes) necesarios para Google Sheets y Drive
    scopes = [
        "https://www.googleapis.com/auth/spreadsheets",
        "https://www.googleapis.com/auth/drive"
    ]
    
    # 3. Cargar las credenciales desde el diccionario de forma segura
    creds = Credentials.from_service_account_info(creds_dict, scopes=scopes)
    
    # 4. Autorizar el cliente de gspread
    cliente = gspread.authorize(creds)
    return cliente
